{
  "name": "sniper_game",
  "version": "0.1.0",
  "description": "A precision rifle trainer for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core",
    "test:core": "esbuild tests/core.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/core.test.bundle.mjs --log-level=error && node node_modules/.cache/core.test.bundle.mjs",
    "dope": "esbuild tests/dope.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/dope.bundle.mjs --log-level=error && node node_modules/.cache/dope.bundle.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ipaliog-a11y/sniper_game"
  },
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
